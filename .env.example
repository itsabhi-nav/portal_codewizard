# ============================================================================
# CodeWizard Agency Management Portal - Environment Configuration
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` or `.env` to Git.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=CodeWizard
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development

# ---------------------------------------------------------------------------
# Admin Authentication
# ADMIN_USERNAME / ADMIN_PASSWORD are read on the server only.
# ADMIN_SESSION_SECRET must be a long random string (min 32 chars).
# Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=

# Session lifetime in seconds (default 43200 = 12 hours)
ADMIN_SESSION_TTL=43200

# ---------------------------------------------------------------------------
# Supabase
# Create a project at https://supabase.com and paste the values here.
# The anon key is public (used only by the browser if needed).
# The service role key is SECRET - it must never be exposed to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Razorpay
# Create keys at https://dashboard.razorpay.com/ -> Settings -> API Keys
# Use test keys first (key IDs starting with rzp_test_).
# The webhook secret is configured under Settings -> Webhooks.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Enable Razorpay payment processing (set to false to disable payments)
RAZORPAY_ENABLED=false

# ---------------------------------------------------------------------------
# Scheduled Jobs
# Generate with: openssl rand -hex 32
# This protects the cron endpoint /api/cron/amc-check
# ---------------------------------------------------------------------------
CRON_SECRET=

# Cron schedule (default 1:00 AM Asia/Kolkata). Used by docs/scheduler config.
CRON_SCHEDULE=0 1 * * *

# ---------------------------------------------------------------------------
# License Engine
# ---------------------------------------------------------------------------
# How long license responses may be cached in-process (seconds; 0 = always verify)
LICENSE_CACHE_TTL=0
# Signing secret for license responses. Generate with: openssl rand -hex 32
LICENSE_SIGNING_SECRET=
# How long a signed license response is valid (seconds)
LICENSE_RESPONSE_TTL=3600
# Bounded offline policy: allow previously verified licenses to keep working
# for this many seconds when the license service is unavailable.
# Expired/revoked licenses are never granted indefinite access.
LICENSE_OFFLINE_GRACE_SECONDS=86400
# When the license service is unreachable, fail closed (suspend) or fail open
# within the bounded offline grace. Default: closed (secure).
LICENSE_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Optional Notifications / Branding
# ---------------------------------------------------------------------------
WHATSAPP_BASE_URL=https://wa.me/
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ---------------------------------------------------------------------------
# Optional: Local Supabase (docker compose)
# If you run `npm run db:up`, these are the local defaults.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
